{
  "expo": {
    "name": "Social Eyes",
    "slug": "social-eyes",
    "scheme": "socialeyes",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socialeyes.app",
      "icon": "./assets/images/social-eyes-icon.png"
    },
    "android": {
      "package": "com.socialeyes.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/social-eyes-adaptive-foreground.png",
        "backgroundColor": "#0A1026"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/images/social-eyes-icon.png"
  }
}
