{
  "expo": {
    "name": "Social Eyes",
    "slug": "social-eyes",
    "scheme": "socialeyes",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socialeyes.app"
    },
    "android": {
      "package": "com.socialeyes.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
